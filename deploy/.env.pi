# Raspberry Pi appliance config — copied to patient_monitor_backend/.env by setup-pi.sh
# LAN bedside monitor: one ESP32 feeds PT-000001; simulator fills in when idle.

# --- Kiosk display scaling ---
# Large bedside TV viewed from a distance: scale the whole UI up crisply.
# 1.0 = native, 1.5 = 50% bigger. Bump toward 2.0 on a 4K panel. Read by start-kiosk.sh.
KIOSK_SCALE=1.5

# --- MQTT (local mosquitto broker on the Pi) ---
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=patient-monitor

# --- Telemetry source ---
# Real hardware publishes to patient-monitor/PT-000001/telemetry.
# Keep the built-in ESP32 simulator OFF, but let the idle watchdog auto-run it
# until real telemetry arrives (so the screen shows data on boot).
SIMULATE_ESP32=false
AUTO_SIMULATE_WHEN_IDLE=true
IDLE_SIMULATOR_SEC=8
SIMULATOR_RATE_SEC=1.0
SIMULATED_PATIENT_ID=PT-000001

# --- AI assessment ---
# LLM OFF by default on a 2 GB Pi (Torch + Chromium + Ollama can OOM).
# NEWS2 + the rule-based engine still fully populate the AI panel.
# To enable: add zram/swap (see README-pi.md), install ollama + qwen2.5:0.5b,
# then set USE_LLM=true and reboot.
USE_LLM=false
OLLAMA_HOST=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:0.5b

# --- Served on the Pi itself; Chromium opens http://localhost:8000 ---
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
